{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/s/**", "run": {"serviceId": "cliphouse-share", "region": "europe-west1"}},
      {"source": "/p/**", "run": {"serviceId": "cliphouse-share", "region": "europe-west1"}},
      {"source": "/l/**", "run": {"serviceId": "cliphouse-share", "region": "europe-west1"}},
      {"source": "/api/logos", "run": {"serviceId": "cliphouse-share", "region": "europe-west1"}},
      {"source": "/api/shares{,/**}", "run": {"serviceId": "cliphouse-share", "region": "europe-west1"}},
      {"source": "/api/health", "run": {"serviceId": "cliphouse-share", "region": "europe-west1"}},
      {"source": "/.well-known/mcp-registry-auth", "run": {"serviceId": "cliphouse-share", "region": "europe-west1"}},
      {"source": "/.well-known/mcp.json", "run": {"serviceId": "cliphouse-share", "region": "europe-west1"}},
      {"source": "/mcp", "run": {"serviceId": "cliphouse-share", "region": "europe-west1"}}
    ],
    "headers": [
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups"},
        {"key": "X-Frame-Options", "value": "DENY"}
      ]},
      {"source": "/assets/**", "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}, {"key": "Access-Control-Allow-Origin", "value": "*"}]},
      {"source": "/hyperframes/**", "headers": [{"key": "Access-Control-Allow-Origin", "value": "*"}]},
      {"source": "/previews/**", "headers": [{"key": "Cache-Control", "value": "public,max-age=3600"}]},
      {"source": "/source/**", "headers": [{"key": "Cache-Control", "value": "public,max-age=31536000,immutable"}, {"key": "Access-Control-Allow-Origin", "value": "*"}]},
      {"source": "**/agent.json", "headers": [{"key": "Cache-Control", "value": "public,max-age=300"}, {"key": "Access-Control-Allow-Origin", "value": "*"}]},
      {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "firestore": {"rules": "firestore.rules"}
}
