{
  "name": "cliphouse",
  "version": "1.0.0",
  "description": "Find, remix, and save video templates on cliphou.se",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/smoke-account.cjs",
    "test:rules": "firebase emulators:exec --project demo-cliphouse --only firestore \"node --import tsx --test --test-concurrency=1 scripts/rules.test.mjs server/store.integration.ts\"",
    "test:sharing": "node --import tsx --test server/*.test.ts scripts/limits.test.ts scripts/gate.test.ts",
    "test:agent": "node --import tsx --test scripts/agent.test.ts scripts/brandkit.test.ts scripts/agent-contract.test.ts",
    "test:source-render": "node scripts/source-render.test.mjs",
    "sources": "node scripts/build-sources.mjs",
    "previews:hyperframes": "node --import tsx scripts/hyperframes-previews.mjs",
    "build:sharing": "node scripts/build-share.mjs",
    "start:sharing": "node --import tsx server/index.ts",
    "dev": "vite",
    "build": "node scripts/build-music-runtime.mjs --check && node --import tsx scripts/check-direction.mjs --records && node scripts/build-sources.mjs --check && tsc && vite build && node --import tsx scripts/build-seo.mjs && node --import tsx scripts/build-benchmark.tsx",
    "benchmark:plan": "node scripts/benchmark/run.mjs",
    "benchmark:run": "node scripts/benchmark/run.mjs --execute",
    "benchmark:repair": "node scripts/benchmark/run-recovery.mjs",
    "benchmark:publish-repairs": "node scripts/benchmark/publish-recovery.mjs",
    "benchmark:timings": "node scripts/benchmark/collect-timings.mjs",
    "test:benchmark": "node --import tsx --test scripts/benchmark/*.test.mjs scripts/benchmark/*.test.tsx",
    "test:benchmark-build": "node scripts/benchmark/check-build.mjs",
    "test:video-policy": "node scripts/check-video-policy.mjs",
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc",
    "music:runtime": "node scripts/build-music-runtime.mjs",
    "beat:runtime": "node scripts/build-beat-runtime.mjs",
    "music:hashes": "node --import tsx scripts/music-hashes.mjs",
    "test:music": "node --import tsx --test scripts/music.test.ts",
    "test:direction": "node --import tsx scripts/check-direction.mjs --sheets output/direction-gates",
    "test:music-export": "node scripts/build-share.mjs && node --import tsx scripts/music-export.mjs",
    "test:music-source": "node --import tsx scripts/music-source.test.mjs",
    "test:music-browser": "node scripts/smoke-music.cjs",
    "test:gate": "node scripts/smoke-gate.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT-0",
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hyperframes/player": "0.8.146",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@react-three/fiber": "^9.8.1",
    "@remotion/cli": "^4.0.534",
    "@remotion/fonts": "^4.0.534",
    "@remotion/player": "^4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/three": "^4.0.534",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "hyperframes": "0.8.146",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.534",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@remotion/bundler": "4.0.534",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "firebase-tools": "^15.32.1",
    "gsap": "3.14.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}
